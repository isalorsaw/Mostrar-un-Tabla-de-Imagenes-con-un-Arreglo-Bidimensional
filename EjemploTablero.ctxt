comment6.text=static\ void\ cargarImagenes(ImageIcon[][]\ arr,\ int\ f,\ int\ c)\ \r\n\ \ \ \ {\r\n\ \ \ \ \ \ \ \ for\ (int\ i\ \=\ 0;\ i\ <\ f;\ i++)\ \r\n\ \ \ \ \ \ \ \ {\r\n\ \ \ \ \ \ \ \ \ \ \ \ for\ (int\ j\ \=\ 0;\ j\ <\ c;\ j++)\ \r\n\ \ \ \ \ \ \ \ \ \ \ \ {\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ //arr[i][j]\ \=\ new\ ImageIcon("imagenes/img_"\ +\ i\ +\ "_"\ +\ j\ +\ ".png");\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ int\ alea\=generaAleatorio(1,9);\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ arr[i][j]\ \=\ new\ ImageIcon("imagenes/"+alea+\ ".jpg");\r\n\ \ \ \ \ \ \ \ \ \ \ \ }\r\n\ \ \ \ \ \ \ \ }\r\n}
comment7.params=arr\ f\ c
comment7.target=void\ mostrarTablero(javax.swing.ImageIcon[][],\ int,\ int)
comment7.text=static\ void\ mostrarTablero(ImageIcon[][]\ arr,\ int\ f,\ int\ c)\ \r\n\ \ \ \ {\r\n\ \ \ \ \ \ \ \ JPanel\ panel\ \=\ new\ JPanel(new\ GridLayout(f,\ c));\r\n\ \ \ \ \ \ \ \ \r\n\ \ \ \ \ \ \ \ for\ (int\ i\ \=\ 0;\ i\ <\ f;\ i++)\ \r\n\ \ \ \ \ \ \ \ {\r\n\ \ \ \ \ \ \ \ \ \ \ \ for\ (int\ j\ \=\ 0;\ j\ <\ c;\ j++)\ \r\n\ \ \ \ \ \ \ \ \ \ \ \ {\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ JLabel\ label\ \=\ new\ JLabel(arr[i][j]);\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ label.setBorder(BorderFactory.createLineBorder(Color.BLACK));\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ panel.add(label);\r\n\ \ \ \ \ \ \ \ \ \ \ \ }\r\n\ \ \ \ \ \ \ \ }\r\n\ \ \ \ \ \ \ \ \r\n\ \ \ \ \ \ \ \ JOptionPane.showMessageDialog(null,\ panel,\ "Mi\ Tablero",\ JOptionPane.PLAIN_MESSAGE);\r\n}
